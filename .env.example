# Security: Generate a distinct value with: openssl rand -base64 48
# REQUIRED in production for session security
SESSION_SECRET=

# Captcha
CAPTCHA_SECRET=

# Database
DATABASE_URL=

# Razorpay Payment
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Proxy Settings
# Set to true only behind a proxy that strips incoming x-forwarded-for headers
TRUST_PROXY=false

# Cloudinary Image Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Product-image server (Cloudinary): every new product image is uploaded by the
# protected /api/upload route and only its HTTPS delivery URL is stored in the database.

# Email notifications - create an API key at https://resend.com and use a verified sender address
RESEND_API_KEY=
EMAIL_FROM="Bhatia Stores <orders@your-domain.com>"
ORDER_NOTIFICATION_EMAIL=

# Additional Security
NODE_ENV=development
ENABLE_IMPORT_ROUTE=false
IMPORT_SECRET=
